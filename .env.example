# The full Devnet round trip is opt-in and sends a paid transaction.
DBRIX_RUN_DEVNET_ROUNDTRIP=0

# Local path to the Solana signer keypair JSON used to sign and pay the transaction fee.
DBRIX_SIGNER_KEYPAIR=

# Caller-selected Solana JSON-RPC endpoint; required only when the live test is enabled.
DBRIX_SOLANA_RPC=

# Optional JSON file containing a record to encrypt instead of the built-in TCAP fixture.
# DBRIX_TEST_PAYLOAD=C:\path\to\record.json
