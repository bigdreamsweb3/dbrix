{
  "name": "@dbrix/solana",
  "version": "0.1.0",
  "description": "Solana Memo v1 transport, wallet signing, and RPC readback for DBrix payloads.",
  "keywords": ["dbrix", "solana", "transactions", "memo"],
  "license": "MIT",
  "author": "Agbaka Daniel Ugonna (Big Dreams Web3)",
  "repository": {
    "type": "git",
    "url": "https://github.com/bigdreamsweb3/dbrix.git",
    "directory": "solana"
  },
  "homepage": "https://github.com/bigdreamsweb3/dbrix/tree/main/solana#readme",
  "bugs": { "url": "https://github.com/bigdreamsweb3/dbrix/issues" },
  "publishConfig": { "access": "public" },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/client/readMemoTransaction.ts --format esm --dts --clean",
    "prepublishOnly": "npm run build",
    "read:memo": "node ./dist/client/readMemoTransaction.js",
    "test:solana": "vitest run --reporter=verbose --silent=false test/memo-v1.spec.ts"
  },
  "devDependencies": {
    "@types/node": "^25.0.8",
    "tsup": "^8.0.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "dependencies": {
    "@solana/kit": "^8.5.0",
    "@solana/web3.js": "^1.99.0"
  }
}
